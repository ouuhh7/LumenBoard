#!/bin/sh
set -eu

SERVICE="user/foreground/com.iuyghi.lumenboardd"
PLIST="/var/jb/Library/LaunchDaemons/com.iuyghi.lumenboardd.plist"
LAUNCHCTL="${LUMENBOARD_LAUNCHCTL:-/bin/launchctl}"

# dpkg may configure an already-registered service. launchd returns 37 in
# that case; treat only this specific condition as success.
if bootstrap_output=$("$LAUNCHCTL" bootstrap user/foreground "$PLIST" 2>&1); then
    :
else
    case "$bootstrap_output" in
        *"service already bootstrapped"*) ;;
        *)
            echo "LumenBoard: launchd bootstrap failed: $bootstrap_output" >&2
            exit 1
            ;;
    esac
fi

if ! "$LAUNCHCTL" kickstart -k "$SERVICE"; then
    echo "LumenBoard: launchd could not start $SERVICE." >&2
    exit 1
fi

if service_state=$("$LAUNCHCTL" print "$SERVICE" 2>&1); then
    case "$service_state" in
        *"state = running"*|*"pid = "[1-9]*)
            exit 0
            ;;
    esac
fi

echo "LumenBoard: launchd did not report the daemon as running ($SERVICE)." >&2
exit 1
