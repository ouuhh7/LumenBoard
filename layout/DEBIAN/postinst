#!/bin/sh
set -eu

SERVICE="user/foreground/com.iuyghi.lumenboardd"
PLIST="/var/jb/Library/LaunchDaemons/com.iuyghi.lumenboardd.plist"

if /bin/launchctl print "$SERVICE" >/dev/null 2>&1; then
    /bin/launchctl bootout "$SERVICE"
fi

# Dopamine rootless services run in the foreground user's launchd domain.
# Use shell builtins for state inspection; do not depend on external grep/sleep.
/bin/launchctl bootstrap user/foreground "$PLIST"
/bin/launchctl kickstart -k "$SERVICE"

if service_state=$(/bin/launchctl print "$SERVICE" 2>&1); then
    case "$service_state" in
        *"state = running"*|*"pid = "[1-9]*)
            exit 0
            ;;
    esac
fi

echo "LumenBoard: launchd did not report the daemon as running ($SERVICE)." >&2
exit 1
